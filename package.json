{
  "name": "world-radio-app",
  "version": "1.0.0",
  "description": "Live internet radio with favorites, car controls and an installable offline app shell. Built with React and styled-components.",
  "scripts": {
    "start": "vite",
    "build": "vite build && node scripts/write-build-manifest.cjs && node scripts/build-service-worker.cjs",
    "serve": "vite preview",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:pwa": "node scripts/pwa-worker.test.cjs",
    "test:build": "node scripts/build-output.test.cjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:bundle": "node scripts/check-bundle.cjs",
    "check:security": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run format:check && npm test && npm run test:pwa && npm run build && npm run test:build && npm run check:bundle",
    "check:streams": "node scripts/check-streams.cjs",
    "test:streams": "node --test scripts/check-streams.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silentmaster86/world-radio-app.git"
  },
  "keywords": [],
  "author": "Przemysław Pietkun",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Silentmaster86/world-radio-app/issues"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5",
    "styled-components": "^6.6.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-x": "^5.28.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "vite": "^8.3.6"
  }
}
